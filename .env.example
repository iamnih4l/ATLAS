# Environment Variables for ATLAS
# Copy this file to .env.local and fill in your values

# ============================================================
# SUPABASE (PostgreSQL + PostGIS + Auth + Storage)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# CESIUM ION (Optional — 3D Earth uses CartoDB Dark Matter / OSM tiles by default)
# ============================================================
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token

# ============================================================
# AI PROVIDER (Orion Experience Companion)
# Options: openai, google, anthropic
# ============================================================
AI_PROVIDER=openai
AI_API_KEY=your_api_key
AI_MODEL=gpt-4o

# ============================================================
# GOOGLE DRIVE & OAUTH (Optional Photo Import)
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
